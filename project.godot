[layer_names]

3d_physics/layer_1="env"
3d_physics/layer_2="player"
3d_physics/layer_3="interactables"
3d_physics/layer_4="turret"
3d_physics/layer_5="glitched"
3d_physics/layer_6="noclip"

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/generate_all_kinematic_contacts=true
jolt_physics_3d/queries/enable_ray_cast_face_index=true
3d/default_gravity=20.0
common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=2
textures/canvas_textures/default_texture_repeat=1
rendering_device/driver.windows="d3d12"
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=3
camera/depth_of_field/depth_of_field_bokeh_quality=2
camera/depth_of_field/depth_of_field_use_jitter=true
environment/subsurface_scattering/subsurface_scattering_quality=2
anti_aliasing/quality/screen_space_aa=2
occlusion_culling/use_occlusion_culling=true

[richer_text_label]

fonts={
&"Ethnocentric": "res://commons/fonts/Ethnocentric-Regular.otf",
&"Gak Tahu": "res://commons/fonts/Gak Tahu.ttf"
}

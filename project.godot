; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

metadata_manager/template_script_path="uid://e2greom6d80g"

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Manumentum"
config/version="0.0.1"
run/main_scene="uid://biuk2n8t021vi"
config/features=PackedStringArray("4.6", "C#", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://cx31efi6nj0v3"

[autoload]

CollisionPresetRuntime="*uid://u810pt6u5apa"
EventBus="*uid://c6eo2p7cfvmf6"
SettingsManager="*uid://bcitpw3xhbhpy"
RadioModule="*uid://dms4ukds2g1lg"
GhostEffectModule="*uid://df22x30c4v0i8"
LevelManager="*uid://c0cbiwewmxg0m"

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"
window/vsync/vsync_mode=3

[dotnet]

project/assembly_name="Manufaktur"

[editor]

movie_writer/video_quality=1.0
movie_writer/ogv/audio_quality=1.0
movie_writer/ogv/encoding_speed=3
movie_writer/movie_file="/tmp/video.ogv"

[editor_plugins]

enabled=PackedStringArray("res://addons/collision_presets/plugin.cfg", "res://addons/diagnosticlist/plugin.cfg", "res://addons/godot_3d_auto_collision_generator/plugin.cfg", "res://addons/godot_material_footsteps/plugin.cfg", "res://addons/godot_resource_groups/plugin.cfg", "res://addons/proton_scatter/plugin.cfg", "res://addons/richtext2/plugin.cfg")

[filesystem]

import/blender/enabled=false

[global_group]

finish=""
spawn_point=""

[godot_resource_groups]

auto_rebuild=true

